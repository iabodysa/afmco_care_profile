#!/bin/sh
set -u

msg=$(grep -v '^#' "$1")

if printf '%s\n' "$msg" | grep -qiE '^(co-authored-by|claude-session|signed-off-by):|claude\.ai/code|generated with'; then
	echo "commit-msg: attribution trailer or session link in the message; keep the subject line only" >&2
	exit 1
fi

if printf '%s\n' "$msg" | LC_ALL=C grep -q "$(printf '[\330-\333]')"; then
	echo "commit-msg: Arabic in the commit message; keep it English" >&2
	exit 1
fi
